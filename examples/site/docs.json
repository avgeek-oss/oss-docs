{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "appearance": {
    "default": "system"
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "system"
  },
  "interaction": {
    "drilldown": false
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "seo": {
    "indexing": "all",
    "metatags": {
      "og:type": "website",
      "twitter:card": "summary_large_image"
    }
  },
  "name": "Example",
  "description": "A sample project for the shared documentation kit.",
  "logo": {
    "light": "/logo.svg",
    "dark": "/logo.svg",
    "href": "/"
  },
  "favicon": "/logo.svg",
  "colors": {
    "primary": "#A16207",
    "light": "#B08505",
    "dark": "#B9872C"
  },
  "navigation": {
    "dropdowns": [
      {
        "dropdown": "Introduction",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get started",
            "pages": ["guide", "reference"]
          }
        ]
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Docs",
      "href": "/guide"
    }
  },
  "footer": {
    "links": [
      {
        "header": "Documentation",
        "items": [
          {
            "label": "Get started",
            "href": "/guide"
          },
          {
            "label": "Reference",
            "href": "/reference"
          }
        ]
      },
      {
        "header": "Our OSS Philosophy",
        "items": [
          {
            "label": "Why we build open source",
            "href": "https://github.com/avgeek-oss/.github/blob/main/profile/README.md"
          },
          {
            "label": "Report an issue",
            "href": "https://github.com/avgeek-oss/oss-docs/issues"
          }
        ]
      },
      {
        "header": "Other OSS Apps",
        "items": [
          {
            "label": "Towbar · Deploy your apps",
            "href": "https://www.towbar.dev"
          },
          {
            "label": "Vitalog · Keep your health ledger",
            "href": "https://www.vitalog.dev"
          },
          {
            "label": "All OSS projects",
            "href": "https://github.com/avgeek-oss/.github/blob/main/profile/README.md#whats-in-the-list"
          }
        ]
      }
    ],
    "socials": {
      "github": "https://github.com/avgeek-oss"
    }
  },
  "redirects": []
}
