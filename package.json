{
  "name": "@avgeek-oss/mintlify-docs",
  "version": "0.2.0",
  "description": "Shared Mintlify homepage layouts, documentation primitives and site tooling for Avgeek OSS projects",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.5.3+sha512.7ac1c919341c213a34dc0d02afb7143c5c26ac26ee8c4782deea821b8ac64d2134a081fd8941dae6e29bbb48f58dfc2b7fbceeccc07cb2f09d219d342a4969ed",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avgeek-oss/oss-docs.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs"
    }
  },
  "bin": {
    "mintlify-docs": "./bin/mintlify-docs.mjs"
  },
  "files": [
    "src",
    "bin",
    "assets",
    "snippets",
    "README.md",
    "docs",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "dev": "node scripts/preview.mjs && cd .preview/site && npx --yes mint@4.2.986 dev --port 4176",
    "validate:fixture": "node scripts/validate-fixture.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives . && pnpm lint:styles",
    "lint:styles": "stylelint \"assets/*.css\"",
    "test": "node --test test/*.test.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm test && node scripts/verify-package.mjs",
    "test:published": "node scripts/verify-package.mjs --published"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.0",
    "jsdom": "^30.1.3",
    "oxlint": "1.90.0",
    "stylelint": "^17.16.0"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "prettier": "3.9.10"
  }
}
